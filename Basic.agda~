record Prop (M : Model) : Set₁ where
  field
    val : 𝐖 M → Set₀
    
open Prop public


_,_⊨_ : ∀ (M : Model) → 𝐖 M → Prop M → Set₀
M , w ⊨ F = val F w

infixr 10 _,_⊨_


{-

Valid : ∀ (M : Model) → Prop M → Set₀
Valid M A = ∀ (w : 𝐖 M) → M , w ⊨ A

⊨_ : (∀ (M : Model) → Prop M) → Set₁            Мне кажется, что эти определения излишние для нашего shallow embedding.
⊨ A = ∀ (M' : Model) → Valid M' (A M')        Так что можно пока их считать просто упражнением на формализацию  


infixr 9  ⊨_

-}

□_ : ∀ {M : Model} → Prop M → Prop M
□_ {M} F =
  record
    { val = λ w →
        ∀ w' →
        𝐑 M w w' →
        M , w' ⊨ F
    }


◇_ : ∀ {M : Model} → Prop M → Prop M
◇_ {M} F =
  record
    { val = λ w →
        Σ (𝐖 M) λ w' →
        𝐑 M w w' × M , w' ⊨ F
    }


~_ : ∀ {M : Model} → Prop M → Prop M
~_ {M} F =
  record
    { val = λ w →
        ¬ (M , w ⊨ F)
    }


_⇒_ : ∀ {M : Model} → Prop M → Prop M → Prop M
_⇒_ {M} A B =
  record
    { val = λ w →
        M , w ⊨ A →
        M , w ⊨ B
    }


_∧_ : ∀ {M : Model} → Prop M → Prop M → Prop M
_∧_ {M} A B =
  record
    { val = λ w →
        (M , w ⊨ A) ×
        (M , w ⊨ B)
    }


_∨_ : ∀ {M : Model} → Prop M → Prop M → Prop M
_∨_ {M} A B =
  record
    { val = λ w →
        (M , w ⊨ A) ⊎
        (M , w ⊨ B)
    }


_⇔_ : ∀ {M : Model} → Prop M → Prop M → Prop M
_⇔_ {M} A B =
  (A ⇒ B) ∧ (B ⇒ A)


∀ᵐ[_] : ∀ {M : Model} → (𝐃 M → Prop M) → Prop M
∀ᵐ[ P ] =
  record
    { val = λ w →
        ∀ d →
        val (P d) w
    }


∃ᵐ[_] : ∀ {M : Model} → (𝐃 M → Prop M) → Prop M
∃ᵐ[ P ] =
  record
    { val = λ w →
        Σ _ λ d →
        val (P d) w
    }


_>_ : ∀ {M : Model} → Prop M → Prop M → Prop M
_>_ {M} A B =
  record
    { val = λ w →
        ∀ w' →
        𝐅 M (val A) w w' →
        M , w' ⊨ B
    }


infixr 100 ~_
infixr 100 □_
infixr 100 ◇_
infixr 50 _∨_
infixr 40 _∧_
infixr 30 _⇒_
infixr 20 _⇔_
infixr 15 _>_
infixr 100 ∀ᵐ[_]
infixr 100 ∃ᵐ[_]

Reflexive : ∀ {M : Model} → Set₀
Reflexive {M} =
  ∀ w →
  𝐑 M w w


Symmetric : ∀ {M : Model} → Set₀
Symmetric {M} =
  ∀ {w w'} →
  𝐑 M w w' →
  𝐑 M w' w


Transitive : ∀ {M : Model} → Set₀
Transitive {M} =
  ∀ {w w' w''} →
  𝐑 M w w' →
  𝐑 M w' w'' →
  𝐑 M w w''


Serial : ∀ {M : Model} → Set₀
Serial {M} =
  ∀ w →
  Σ (𝐖 M) λ w' →
  𝐑 M w w'


Euclidean : ∀ {M : Model} → Set₀
Euclidean {M} =
  ∀ {w v u} →
  𝐑 M w v →
  𝐑 M w u →
  𝐑 M v u



K_axiom : ∀ (M : Model) (w : 𝐖 M) (A B : Prop M) → M , w ⊨ □ (A ⇒ B) →  M , w ⊨ □ A ⇒ □ B
K_axiom M w A B H1 H2 = Goal where

 H1_unf : ∀ w' →  𝐑 M w w' → M , w' ⊨ A ⇒ B
 H1_unf = H1

 H2_unf :  ∀ w' →  𝐑 M w w' → M , w' ⊨ A
 H2_unf = H2

 Goal : ∀ w' →  𝐑 M w w' → M , w' ⊨ B
 Goal = λ w' RMww' → (H1_unf w' RMww') (H2_unf w' RMww')

 


Nec : ∀ (M : Model) → (A : Prop M) → (∀ w → M , w ⊨ A) → (∀ w → M , w ⊨ □ A)
Nec M A H w = Goal where

 Goal :  ∀ w' →  𝐑 M w w' → M , w' ⊨ A
 Goal = λ w' RMww' → H w'

>_weakness_right : ∀ (M : Model) (w : 𝐖 M) (A B C : Prop M) → M , w ⊨ A > B → M , w ⊨ A > (B ∨ C)
>_weakness_right M w A B C H = Goal where

 H_unf : ∀ w' → 𝐅 M (val A) w w' → M , w' ⊨ B
 H_unf = H

 Goal : ∀ w' → 𝐅 M (val A) w w' → M , w' ⊨ B ∨ C
 Goal = λ w' F → inj₁ (H_unf w' F)


data Worlds-2 : Set where
 world-one : Worlds-2
 world-two : Worlds-2

data Worlds-3 : Set where
 world-one : Worlds-3
 world-two : Worlds-3
 world-three : Worlds-3

lemma-1 : ¬ ∀ (M : Model) (w : 𝐖 M) (A B C : Prop M) → (M , w ⊨ A > B) → (M , w ⊨ A ∧ B > C)
lemma-1 H = Goal where

 F-countermodel : (Worlds-2 → Set₀) → Worlds-2 → Worlds-2 → Set₀
 F-countermodel P world-one world-one = ⊥
 F-countermodel P world-one world-two = P world-one → ⊥
 F-countermodel P world-two _ = ⊥

 Countermodel : Model
 Countermodel =
   record
     { 𝐖 = Worlds-2 ;
       witness-w = world-one ;
       𝐃 = Worlds-2 ;
       witness-d = world-two ;
       𝐑 = λ _ _ → ⊥ ;
       𝐅 = F-countermodel }

 A : Prop Countermodel
 A = record {val = λ _ → ⊤}

 B : Prop Countermodel
 B = record {val = λ _ → ⊥}

 C : Prop Countermodel
 C = record {val = λ _ → ⊥}

 Antecedent : Countermodel , world-one ⊨ A > B
 Antecedent world-one ()
 Antecedent world-two h = h tt

{- То есть по A из первого мира никакой мир не доступен, поэтому A > B выполняется -}

 Consequent : {!!}
 Consequent = {!!}

 Goal : ⊥
 Goal = H Countermodel world-one A B C Antecedent world-two (λ (_ , b) → b)

{- λ (_ , b) → b имеет тип (⊤ × ⊥) → ⊥ -}
